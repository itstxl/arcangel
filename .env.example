# Get these from id -u, id -g, and stat -c '%g' -- /dev/dri/renderD128.
RUN_UID=
RUN_GID=
RENDER_GID=
RENDER_NODE=/dev/dri/renderD128
MODELS_DIR=

# The default is the B580 full-VRAM profile. Uncomment these four lines for B60 offload.
